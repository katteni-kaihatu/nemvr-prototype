{
  "schemaVersion": 1,
  "maxDimensions": 48,
  "maxEntityBytes": 2048,
  "maxObjects": 100,
  "maxFilterPredicates": 8,
  "dimensions": {
    "entity.kind": { "type": "enum", "values": ["box", "image", "file", "link", "peer"], "write": "create" },
    "session.id": { "type": "string", "maxLength": 64, "write": "server" },
    "space.position": { "type": "vec3", "min": -1000, "max": 1000, "write": "client" },
    "space.yaw": { "type": "number", "write": "client" },
    "space.pitch": { "type": "number", "write": "client" },
    "space.roll": { "type": "number", "write": "client" },
    "space.scale": { "type": "number", "min": 0.1, "max": 10, "write": "client" },
    "space.deform": { "type": "object", "write": "client" },
    "space.head": { "type": "quat", "write": "client" },
    "space.crouch": { "type": "number", "min": 0, "max": 1, "write": "client" },
    "space.lean": { "type": "number", "min": -1, "max": 1, "write": "client" },
    "space.xr.left.position": { "type": "vec3", "min": -1000, "max": 1000, "write": "client" },
    "space.xr.left.rotation": { "type": "quat", "write": "client" },
    "space.xr.left.tracked": { "type": "boolean", "write": "client" },
    "space.xr.right.position": { "type": "vec3", "min": -1000, "max": 1000, "write": "client" },
    "space.xr.right.rotation": { "type": "quat", "write": "client" },
    "space.xr.right.tracked": { "type": "boolean", "write": "client" },
    "time.createdAt": { "type": "number", "write": "server" },
    "time.updatedAt": { "type": "number", "write": "server" },
    "time.playback": { "type": "playback", "write": "client" },
    "interaction.heldBy": { "type": "string", "nullable": true, "maxLength": 64, "write": "claim" },
    "content.cid": { "type": "string", "maxLength": 128, "write": "create" },
    "content.name": { "type": "string", "maxLength": 120, "write": "create" },
    "content.size": { "type": "number", "min": 0, "write": "server" },
    "content.category": { "type": "enum", "values": ["audio", "video", "file"], "write": "server" },
    "content.stored": { "type": "boolean", "write": "server" },
    "content.owner": { "type": "string", "maxLength": 64, "write": "server" },
    "content.offline": { "type": "boolean", "write": "server" },
    "content.width": { "type": "number", "min": 0.1, "max": 20, "write": "create" },
    "content.height": { "type": "number", "min": 0.1, "max": 20, "write": "create" },
    "content.url": { "type": "string", "maxLength": 2048, "write": "server" },
    "box.size": { "type": "number", "min": 0.1, "max": 20, "write": "create" },
    "box.color": { "type": "color", "write": "create" },
    "peer.name": { "type": "string", "maxLength": 24, "write": "server" },
    "peer.color": { "type": "color", "write": "server" },
    "peer.avatarCid": { "type": "string", "nullable": true, "maxLength": 128, "write": "avatar" },
    "peer.ipfsPeerId": { "type": "string", "maxLength": 128, "write": "client" }
  },
  "required": {
    "box": ["entity.kind", "space.position", "space.yaw", "box.size", "box.color"],
    "image": ["entity.kind", "space.position", "space.yaw", "content.cid", "content.width", "content.height"],
    "file": ["entity.kind", "space.position", "space.yaw", "content.cid", "content.name"],
    "link": ["entity.kind", "space.position", "space.yaw", "content.url"],
    "peer": ["entity.kind", "space.position", "space.head", "peer.name", "peer.color"]
  }
}
