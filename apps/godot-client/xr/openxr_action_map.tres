[gd_resource type="OpenXRActionMap" format=3]

[sub_resource type="OpenXRAction" id="aim_pose"]
resource_name = "aim_pose"
localized_name = "Aim pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="haptic"]
resource_name = "haptic"
localized_name = "Haptic"
action_type = 4
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="move"]
resource_name = "move"
localized_name = "Move"
action_type = 2
toplevel_paths = PackedStringArray("/user/hand/left")

[sub_resource type="OpenXRAction" id="turn"]
resource_name = "turn"
localized_name = "Snap turn"
action_type = 2
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRAction" id="grab"]
resource_name = "grab"
localized_name = "Grab"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRAction" id="menu"]
resource_name = "menu"
localized_name = "Menu"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left")

[sub_resource type="OpenXRAction" id="teleport"]
resource_name = "teleport"
localized_name = "Teleport"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left")

[sub_resource type="OpenXRActionSet" id="action_set"]
resource_name = "proto"
localized_name = "Proto SNS"
actions = [SubResource("aim_pose"), SubResource("haptic"), SubResource("move"), SubResource("turn"), SubResource("grab"), SubResource("teleport"), SubResource("menu")]

[sub_resource type="OpenXRIPBinding" id="bind_aim_left"]
action = SubResource("aim_pose")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="bind_aim_right"]
action = SubResource("aim_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="bind_haptic_left"]
action = SubResource("haptic")
binding_path = "/user/hand/left/output/haptic"

[sub_resource type="OpenXRIPBinding" id="bind_haptic_right"]
action = SubResource("haptic")
binding_path = "/user/hand/right/output/haptic"

[sub_resource type="OpenXRIPBinding" id="bind_move"]
action = SubResource("move")
binding_path = "/user/hand/left/input/thumbstick"

[sub_resource type="OpenXRIPBinding" id="bind_turn"]
action = SubResource("turn")
binding_path = "/user/hand/right/input/thumbstick"

[sub_resource type="OpenXRIPBinding" id="bind_grab"]
action = SubResource("grab")
binding_path = "/user/hand/right/input/trigger/click"

[sub_resource type="OpenXRIPBinding" id="bind_menu"]
action = SubResource("menu")
binding_path = "/user/hand/left/input/menu/click"

[sub_resource type="OpenXRIPBinding" id="bind_teleport"]
action = SubResource("teleport")
binding_path = "/user/hand/left/input/trigger/click"

[sub_resource type="OpenXRInteractionProfile" id="oculus_touch"]
interaction_profile_path = "/interaction_profiles/oculus/touch_controller"
bindings = [SubResource("bind_aim_left"), SubResource("bind_aim_right"), SubResource("bind_haptic_left"), SubResource("bind_haptic_right"), SubResource("bind_move"), SubResource("bind_turn"), SubResource("bind_grab"), SubResource("bind_teleport"), SubResource("bind_menu")]

[sub_resource type="OpenXRInteractionProfile" id="valve_index"]
interaction_profile_path = "/interaction_profiles/valve/index_controller"
bindings = [SubResource("bind_aim_left"), SubResource("bind_aim_right"), SubResource("bind_haptic_left"), SubResource("bind_haptic_right"), SubResource("bind_move"), SubResource("bind_turn"), SubResource("bind_grab"), SubResource("bind_teleport"), SubResource("bind_menu")]

[resource]
action_sets = [SubResource("action_set")]
interaction_profiles = [SubResource("oculus_touch"), SubResource("valve_index")]
