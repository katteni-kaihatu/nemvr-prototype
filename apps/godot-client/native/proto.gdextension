[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://native/linux/debug/libproto_godot.so"
linux.release.x86_64 = "res://native/linux/release/libproto_godot.so"
windows.debug.x86_64 = "res://native/windows/debug/proto_godot.dll"
windows.release.x86_64 = "res://native/windows/release/proto_godot.dll"
