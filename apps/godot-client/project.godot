; Editable desktop client. Network authority lives in the native client core.
config_version=5

[application]
config/name="Proto SNS"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/version="0.4.1"
config/revision="r1"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.075, 0.10, 0.14, 1)

[xr]
openxr/enabled=false
openxr/default_action_map="res://xr/openxr_action_map.tres"
openxr/foveation_level=3
openxr/foveation_dynamic=true
shaders/enabled=true

[audio]
driver/enable_input=true

[physics]
common/physics_ticks_per_second=60
