{
  "name": "prototype-alternative-resonite-1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @proto/server dev",
    "dev:server": "pnpm --filter @proto/server dev",
    "dev:client": "node scripts/dev-godot.mjs",
    "dev:bevy": "rustup run 1.95.0 cargo run -p proto-client",
    "dev:native": "rustup run 1.95.0 cargo run -p proto-client",
    "dev:godot": "node scripts/dev-godot.mjs",
    "build:godot": "node scripts/build-godot.mjs",
    "test:godot": "node scripts/test-godot.mjs",
    "test:godot:mirror": "node scripts/test-godot.mjs --mirror",
    "e2e:godot": "node scripts/e2e-godot.mjs",
    "e2e:godot:mixed": "node scripts/e2e-godot.mjs --mixed",
    "package:godot:linux": "node scripts/package-godot.mjs linux",
    "package:godot:windows": "node scripts/package-godot.mjs windows",
    "smoke:godot:linux": "node scripts/smoke-godot-linux.mjs",
    "smoke:godot:windows": "node scripts/smoke-godot-windows.mjs",
    "build": "node scripts/build-godot.mjs --release",
    "build:native": "rustup run 1.95.0 cargo build --release -p proto-client",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke:ws": "node scripts/smoke-ws.mjs",
    "e2e:client": "node scripts/e2e-godot.mjs",
    "e2e:bevy": "node scripts/e2e-client.mjs",
    "e2e:mirror": "node scripts/test-godot.mjs --mirror",
    "e2e:bevy:mirror": "bash scripts/e2e-mirror.sh",
    "stress:ws": "node scripts/stress-ws.mjs",
    "package:linux": "node scripts/package-godot.mjs linux",
    "package:windows": "bash scripts/package-windows.sh",
    "package:bevy:linux": "bash scripts/package-linux.sh",
    "package:bevy:windows": "bash scripts/package-windows.sh",
    "test:native": "rustup run 1.95.0 cargo test --workspace",
    "clippy:native": "rustup run 1.95.0 cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:native": "rustup run 1.95.0 cargo fmt --all -- --check"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
